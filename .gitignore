fish/.config/fish/fish_variables

# TPM clones each plugin as its own git repo. Committing them would create
# broken gitlink entries - a fresh clone gets empty directories - and they are
# reproducible from the @plugin lines in tmux.conf via `prefix + I`.
tmux/.config/tmux/plugins/

# herdr writes runtime state beside its config (sockets, logs, session and
# plugin state). Only config.toml belongs in here. These patterns are a safety
# net in case `stow herdr` ever folds the whole directory on a machine where
# ~/.config/herdr does not exist yet - use `stow --no-folding herdr` to avoid
# that in the first place.
herdr/.config/herdr/*
!herdr/.config/herdr/config.toml
!herdr/.config/herdr/plugins.txt
!herdr/.config/herdr/install.sh
